// Kvad on the iPhone: the window, the tab bar, and the screens.
// docs/phone-plan.md has the design brief; this is Phase 1 of it.

import { Theme } from "theme.slint";
import {
    Pressable, Icon, PrimaryButton, TextButton, RoundButton, Separator, Card,
    SectionHeader, SectionFooter, Row, Field, LargeTitle, EmptyState, TabItem,
    Scroller, Typing,
} from "parts.slint";
import { AboutSlint, Spinner } from "std-widgets.slint";

export struct Bubble {
    mine: bool,
    text: string,
    streaming: bool,
}

// One model, as the Models screen lists it: grouped by kind, with the
// first and last of each group known so the card's corners fall right.
export struct ModelRow {
    id: string,
    name: string,
    owner: string,
    kind: string,
    resident: bool,
    first: bool,
    last: bool,
}

// One path of a network test's table, its times in ms, as the probe's
// command prints them.
export struct ProbeRow {
    path: string,
    pings: string,
    median: string,
    p90: string,
    max: string,
}

component ConnectScreen inherits Rectangle {
    in property <length> top-inset;
    // The keyboard's height: what is under it can be scrolled up to.
    in property <length> bottom-inset;
    in-out property <string> url;
    in-out property <string> key;
    in property <bool> busy;
    in property <string> error;
    // What an opened link is, until Connect is tapped.
    in property <string> notice;
    callback connect(string, string);
    callback open-probe();
    callback paste-link();

    Scroller {
        y: 0;
        height: root.height - root.bottom-inset;
        began => { url-field.blur(); key-field.blur(); }
        tapped => { url-field.blur(); key-field.blur(); }
        VerticalLayout {
            alignment: start;
            padding-top: root.top-inset + 56px;
            padding-left: Theme.margin;
            padding-right: Theme.margin;
            padding-bottom: 32px;
            spacing: 8px;
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 88px;
                    height: 88px;
                    border-radius: 22px;
                    background: Theme.ink;
                    Icon {
                        source: @image-url("icons/mark.svg");
                        tint: #f0b35a;
                        width: 54px;
                        height: 54px;
                    }
                }
            }
            Rectangle { height: 12px; }
            Text {
                text: "Kvad";
                color: Theme.label;
                font-size: Theme.large-title * 1rem;
                font-weight: 700;
                horizontal-alignment: center;
            }
            Text {
                text: "Your models, on your Mac, from your phone.";
                color: Theme.secondary;
                font-size: Theme.body * 1rem;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
            Rectangle { height: 28px; }
            Card {
                url-field := Field {
                    label: "Server";
                    placeholder: "192.168.1.20:5823 or kvad://…";
                    text <=> root.url;
                    enabled: !root.busy;
                }
                Separator { }
                key-field := Field {
                    label: "Key";
                    placeholder: "Not needed on your own Mac";
                    input-type: InputType.password;
                    text <=> root.key;
                    enabled: !root.busy;
                    accepted => { root.connect(root.url, root.key); }
                }
            }
            HorizontalLayout {
                padding-left: Theme.margin;
                padding-right: Theme.margin;
                SectionFooter {
                    text: "To reach your Mac from anywhere, run kvad remote pair on it and scan its QR code with the Camera, or paste its link here. Or type the address kvad-serve listens on, for this network only. A paired phone keeps its keys in the Keychain, on this phone alone.";
                }
            }
            HorizontalLayout {
                alignment: center;
                TextButton {
                    text: "Paste a pairing link";
                    enabled: !root.busy;
                    clicked => { root.paste-link(); }
                }
            }
            Rectangle { height: 16px; }
            if root.notice != "" && !root.busy: Text {
                text: root.notice;
                color: Theme.label;
                font-size: Theme.subheadline * 1rem;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
            PrimaryButton {
                text: root.busy ? "Connecting…" : "Connect";
                busy: root.busy;
                enabled: !root.busy && root.url != "";
                clicked => { root.connect(root.url, root.key); }
            }
            if root.error != "": Text {
                text: root.error;
                color: Theme.danger;
                font-size: Theme.subheadline * 1rem;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
            // The network test needs no server: on mobile data there is
            // none to connect to until the relay is in.
            Rectangle { height: 24px; }
            HorizontalLayout {
                alignment: center;
                TextButton {
                    text: "Network test";
                    clicked => { root.open-probe(); }
                }
            }
        }
    }
}

component Message inherits HorizontalLayout {
    in property <Bubble> bubble;
    padding-left: root.bubble.mine ? 56px : Theme.margin;
    padding-right: Theme.margin;
    padding-top: 6px;
    padding-bottom: 6px;
    alignment: root.bubble.mine ? LayoutAlignment.end : LayoutAlignment.stretch;
    spacing: 10px;
    if !root.bubble.mine: Rectangle {
        width: 28px;
        height: 28px;
        border-radius: 14px;
        background: Theme.ink;
        Icon {
            source: @image-url("icons/mark.svg");
            tint: #f0b35a;
            width: 17px;
            height: 17px;
        }
    }
    if root.bubble.mine: Rectangle {
        background: Theme.accent;
        border-radius: 19px;
        HorizontalLayout {
            padding-left: 14px;
            padding-right: 14px;
            padding-top: 9px;
            padding-bottom: 9px;
            min-height: mine.measured + 18px;
            mine := Text {
                // See the reply's below.
                property <length> measured: self.preferred-height;
                text: root.bubble.text;
                color: Theme.on-accent;
                font-size: Theme.body * 1rem;
                wrap: word-wrap;
            }
        }
    }
    // Kvad's side has no bubble: a reply is read, not glanced at, and gets
    // the width of the screen.
    if !root.bubble.mine: VerticalLayout {
        horizontal-stretch: 1;
        padding-top: 3px;
        // The text's height at the width it is given, passed up as a plain
        // number: the list above asks for its height in a way that measures
        // the text at another width, and a long reply came out a quarter of
        // its height, so the list would not scroll to the end of it.
        min-height: reply.measured + 3px;
        reply := Text {
            property <length> measured: self.preferred-height;
            text: root.bubble.text == "" && root.bubble.streaming ? "…" : root.bubble.text + (root.bubble.streaming ? " ●" : "");
            color: Theme.label;
            font-size: Theme.body * 1rem;
            wrap: word-wrap;
        }
    }
}

component ChatScreen inherits Rectangle {
    in property <[Bubble]> bubbles;
    in property <string> model;
    in property <string> model-name;
    in property <bool> replying;
    in property <string> error;
    in-out property <string> draft;
    callback send(string);
    callback stop();
    callback pick-model();
    callback new-chat();

    VerticalLayout {
        // The navigation bar: the model is the title, and tapping it chooses.
        Rectangle {
            height: Theme.touch;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                Rectangle { width: Theme.touch; }
                Pressable {
                    horizontal-stretch: 1;
                    clicked => { root.pick-model(); }
                    HorizontalLayout {
                        alignment: center;
                        spacing: 4px;
                        Text {
                            text: root.model == "" ? "Choose a model" : root.model-name;
                            color: Theme.label;
                            font-size: Theme.body * 1rem;
                            font-weight: 600;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        Icon {
                            source: @image-url("icons/chevron-down.svg");
                            tint: Theme.secondary;
                            width: 14px;
                            height: 14px;
                            y: (parent.height - self.height) / 2;
                        }
                    }
                }
                Pressable {
                    width: Theme.touch;
                    enabled: !root.replying && root.bubbles.length > 0;
                    clicked => { root.new-chat(); }
                    Icon {
                        source: @image-url("icons/plus.svg");
                        tint: Theme.accent;
                    }
                }
            }
        }
        Rectangle {
            vertical-stretch: 1;
            if root.bubbles.length == 0: EmptyState {
                icon: @image-url("icons/chat.svg");
                title: "Ask anything";
                text: root.model == "" ? "Choose a model at the top to begin." : "It runs on your Mac. Nothing you write leaves the machines you own.";
            }
            list := Scroller {
                // Stay with the newest words while they arrive, unless the
                // reader has scrolled up to read something older.
                keep-end: true;
                began => { input.clear-focus(); }
                tapped => { input.clear-focus(); }
                column := VerticalLayout {
                    alignment: start;
                    padding-top: 8px;
                    padding-bottom: 8px;
                    for b in root.bubbles: Message {
                        bubble: b;
                    }
                    if root.error != "": HorizontalLayout {
                        padding-left: Theme.margin;
                        padding-right: Theme.margin;
                        Text {
                            text: root.error;
                            color: Theme.danger;
                            font-size: Theme.subheadline * 1rem;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }
        // The composer, on the bar's material, with a hairline above it.
        Rectangle {
            background: Theme.bar;
            Rectangle {
                y: 0;
                height: 1phx;
                background: Theme.separator;
            }
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 10px;
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: 8px;
                Rectangle {
                    horizontal-stretch: 1;
                    min-height: 38px;
                    max-height: 132px;
                    border-radius: 19px;
                    background: Theme.surface;
                    border-width: 1phx;
                    border-color: Theme.separator;
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        padding-top: 8px;
                        padding-bottom: 8px;
                        Rectangle {
                            input := TextInput {
                                text <=> root.draft;
                                changed has-focus => { Typing.active = self.has-focus; }
                                color: Theme.label;
                                font-size: Theme.body * 1rem;
                                single-line: false;
                                wrap: word-wrap;
                                selection-background-color: Theme.accent.with-alpha(0.35);
                            }
                            if input.text == "": Text {
                                x: 0;
                                y: 0;
                                width: parent.width;
                                text: "Message";
                                color: Theme.tertiary;
                                font-size: Theme.body * 1rem;
                            }
                        }
                    }
                }
                VerticalLayout {
                    alignment: end;
                    padding-bottom: 2px;
                    if !root.replying: RoundButton {
                        icon: @image-url("icons/send.svg");
                        enabled: root.draft != "" && root.model != "";
                        clicked => {
                            list.at-end = true;
                            root.send(root.draft);
                        }
                    }
                    if root.replying: RoundButton {
                        icon: @image-url("icons/stop.svg");
                        background: Theme.fill;
                        tint: Theme.label;
                        clicked => { root.stop(); }
                    }
                }
            }
        }
    }
}

component ModelsScreen inherits Rectangle {
    in property <length> top-inset;
    in property <[ModelRow]> models;
    in property <string> server-line;
    in property <bool> loading;
    callback refresh();

    Scroller {
        VerticalLayout {
            alignment: start;
            padding-bottom: 24px;
            LargeTitle {
                title: "Models";
                subtitle: root.server-line;
                if root.loading: Spinner {
                    indeterminate: true;
                    width: 22px;
                    height: 22px;
                }
                if !root.loading: TextButton {
                    text: "Refresh";
                    clicked => { root.refresh(); }
                }
            }
            if root.models.length == 0 && !root.loading: EmptyState {
                icon: @image-url("icons/stack.svg");
                title: "No models yet";
                text: "Pull one on the Mac with kvad pull, or from the web UI.";
            }
            for m in root.models: VerticalLayout {
                if m.first: Rectangle { height: 18px; }
                if m.first: SectionHeader {
                    text: m.kind == "chat" ? "CHAT" : m.kind == "speech" ? "SPEECH" : m.kind == "image" ? "IMAGES" : m.kind == "video" ? "VIDEO" : m.kind == "embedding" ? "EMBEDDING" : "OTHER";
                }
                if m.first: Rectangle { height: 6px; }
                HorizontalLayout {
                    padding-left: Theme.margin;
                    padding-right: Theme.margin;
                    Rectangle {
                        background: Theme.surface;
                        border-top-left-radius: m.first ? Theme.card-corner : 0;
                        border-top-right-radius: m.first ? Theme.card-corner : 0;
                        border-bottom-left-radius: m.last ? Theme.card-corner : 0;
                        border-bottom-right-radius: m.last ? Theme.card-corner : 0;
                        clip: true;
                        VerticalLayout {
                            Row {
                                title: m.name;
                                detail: m.owner;
                                value: m.resident ? "In memory" : "";
                                dot: m.resident;
                            }
                            if !m.last: Separator { inset: Theme.margin; }
                        }
                    }
                }
            }
        }
    }
}

component MoreScreen inherits Rectangle {
    in property <string> server;
    in property <string> version;
    in property <string> who;
    in property <string> path;
    in property <bool> paired;
    callback disconnect();
    callback open-probe();
    callback unpair();

    Scroller {
        VerticalLayout {
            alignment: start;
            padding-bottom: 32px;
            spacing: 6px;
            LargeTitle { title: "More"; }
            SectionHeader { text: "SERVER"; }
            HorizontalLayout {
                padding-left: Theme.margin;
                padding-right: Theme.margin;
                Card {
                    Row { title: "Address"; value: root.server; }
                    Separator { }
                    Row { title: "Version"; value: root.version; }
                    Separator { }
                    Row { title: "Signed in as"; value: root.who; }
                    if root.path != "": Separator { }
                    if root.path != "": Row { title: "Path"; value: root.path; }
                    Separator { }
                    Row {
                        title: "Disconnect";
                        title-color: Theme.danger;
                        clicked => { root.disconnect(); }
                    }
                    if root.paired: Separator { }
                    if root.paired: Row {
                        title: "Unpair this phone";
                        title-color: Theme.danger;
                        clicked => { root.unpair(); }
                    }
                }
            }
            Rectangle { height: 18px; }
            SectionHeader { text: "ON THE MAC"; }
            HorizontalLayout {
                padding-left: Theme.margin;
                padding-right: Theme.margin;
                Card {
                    Row { title: "Jobs and queue"; value: "Soon"; enabled: false; }
                    Separator { }
                    Row { title: "Training and tuning"; value: "Soon"; enabled: false; }
                    Separator { }
                    Row { title: "Evals and benchmarks"; value: "Soon"; enabled: false; }
                    Separator { }
                    Row { title: "Datasets"; value: "Soon"; enabled: false; }
                    Separator { }
                    Row { title: "Monitoring"; value: "Soon"; enabled: false; }
                    Separator { }
                    Row { title: "Cluster"; value: "Soon"; enabled: false; }
                }
            }
            Rectangle { height: 18px; }
            SectionHeader { text: "REMOTE ACCESS"; }
            HorizontalLayout {
                padding-left: Theme.margin;
                padding-right: Theme.margin;
                Card {
                    Row {
                        title: "Network test";
                        chevron: true;
                        clicked => { root.open-probe(); }
                    }
                }
            }
            HorizontalLayout {
                padding-left: Theme.margin * 2;
                padding-right: Theme.margin * 2;
                SectionFooter {
                    text: "Which path this phone reaches your Mac by, through Kvad's relay or directly, and how fast.";
                }
            }
            Rectangle { height: 18px; }
            SectionHeader { text: "ABOUT"; }
            HorizontalLayout {
                padding-left: Theme.margin;
                padding-right: Theme.margin;
                Card {
                    Row { title: "Kvad for iPhone"; value: "0.1.0"; }
                    Separator { }
                    HorizontalLayout {
                        padding: 12px;
                        height: 120px;
                        AboutSlint { }
                    }
                }
            }
        }
    }
}

// Three choices side by side, as UISegmentedControl draws them.
component Segments inherits Rectangle {
    in property <[string]> options;
    in-out property <int> current;
    in property <bool> enabled: true;
    height: 32px;
    border-radius: 9px;
    background: Theme.fill;
    opacity: root.enabled ? 1.0 : 0.5;
    HorizontalLayout {
        padding: 2px;
        for o[i] in root.options: Rectangle {
            horizontal-stretch: 1;
            border-radius: 7px;
            background: i == root.current ? Theme.surface : transparent;
            drop-shadow-blur: i == root.current ? 4px : 0;
            drop-shadow-color: #0000001f;
            Text {
                text: o;
                color: Theme.label;
                font-size: Theme.footnote * 1rem;
                font-weight: i == root.current ? 600 : 400;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            TouchArea {
                enabled: root.enabled;
                clicked => { root.current = i; }
            }
        }
    }
}

// A cell of the network test's table: a number, right-aligned.
component Cell inherits Text {
    width: 56px;
    color: Theme.label;
    font-size: Theme.subheadline * 1rem;
    horizontal-alignment: right;
}

// `relay-probe dial`, run from the phone: docs/relay-plan.md's Phase 0.
component NetworkTestScreen inherits Rectangle {
    in property <length> top-inset;
    in property <length> bottom-inset;
    in property <string> id;
    in-out property <string> ticket;
    in-out property <int> length;
    in property <bool> running;
    in property <string> status;
    in property <string> error;
    in property <string> path;
    in property <string> last;
    in property <float> elapsed;
    in property <float> secs;
    in property <[ProbeRow]> rows;
    in property <string> totals;
    // The lines the command would print, one a line.
    in property <string> log;
    callback paste();
    callback copy-id();
    // Not `start`, which would hide the layouts' `alignment: start`.
    callback start-test();
    callback stop();
    callback close();

    background: Theme.background;
    TouchArea { }
    VerticalLayout {
        padding-top: root.top-inset;
        // The navigation bar.
        Rectangle {
            height: Theme.touch;
            Text {
                text: "Network test";
                color: Theme.label;
                font-size: Theme.body * 1rem;
                font-weight: 600;
            }
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                alignment: end;
                TextButton {
                    text: "Done";
                    bold: true;
                    clicked => { root.close(); }
                }
            }
        }
        Scroller {
            vertical-stretch: 1;
            began => { input.clear-focus(); }
            tapped => { input.clear-focus(); }
            VerticalLayout {
                alignment: start;
                padding-top: 8px;
                padding-bottom: root.bottom-inset + 32px;
                spacing: 6px;

                SectionHeader { text: "TICKET"; }
                HorizontalLayout {
                    padding-left: Theme.margin;
                    padding-right: Theme.margin;
                    Card {
                        HorizontalLayout {
                            padding-left: Theme.margin;
                            padding-right: Theme.margin;
                            padding-top: 10px;
                            padding-bottom: 10px;
                            Rectangle {
                                height: max(3 * 1rem, input.preferred-height);
                                input := TextInput {
                                    text <=> root.ticket;
                                    changed has-focus => { Typing.active = self.has-focus; }
                                    color: Theme.label;
                                    font-family: "Menlo";
                                    font-size: Theme.footnote * 1rem;
                                    single-line: false;
                                    wrap: char-wrap;
                                    enabled: !root.running;
                                    selection-background-color: Theme.accent.with-alpha(0.35);
                                }
                                if input.text == "": Text {
                                    x: 0;
                                    y: 0;
                                    width: parent.width;
                                    text: "kvadprobe:1:…, from relay-probe listen on the Mac";
                                    color: Theme.tertiary;
                                    font-size: Theme.subheadline * 1rem;
                                    wrap: word-wrap;
                                }
                            }
                        }
                        Separator { }
                        Row {
                            title: "Paste from the Mac";
                            title-color: Theme.accent;
                            enabled: !root.running;
                            clicked => { root.paste(); }
                        }
                    }
                }
                HorizontalLayout {
                    padding-left: Theme.margin * 2;
                    padding-right: Theme.margin * 2;
                    SectionFooter {
                        text: "On the Mac, relay-probe listen --allow with this phone's id (below) and --relay https://relay2.kvad.eu, then copy its ticket. For mobile data, turn Wi-Fi off here first.";
                    }
                }

                Rectangle { height: 12px; }
                HorizontalLayout {
                    padding-left: Theme.margin;
                    padding-right: Theme.margin;
                    Segments {
                        options: ["30 s", "1 min", "5 min"];
                        current <=> root.length;
                        enabled: !root.running;
                    }
                }
                Rectangle { height: 6px; }
                HorizontalLayout {
                    padding-left: Theme.margin;
                    padding-right: Theme.margin;
                    if !root.running: PrimaryButton {
                        horizontal-stretch: 1;
                        text: "Start";
                        enabled: root.ticket != "" && root.id != "";
                        clicked => { root.start-test(); }
                    }
                    if root.running: PrimaryButton {
                        horizontal-stretch: 1;
                        text: "Stop";
                        background: Theme.danger;
                        ink: #ffffff;
                        clicked => { root.stop(); }
                    }
                }
                if root.error != "": HorizontalLayout {
                    padding-left: Theme.margin * 2;
                    padding-right: Theme.margin * 2;
                    Text {
                        text: root.error;
                        color: Theme.danger;
                        font-size: Theme.subheadline * 1rem;
                        wrap: word-wrap;
                    }
                }

                if root.running || root.path != "" || root.status != "": VerticalLayout {
                    spacing: 6px;
                    Rectangle { height: 12px; }
                    SectionHeader { text: root.running ? "NOW" : "LAST RUN"; }
                    HorizontalLayout {
                        padding-left: Theme.margin;
                        padding-right: Theme.margin;
                        Card {
                            if root.status != "": Row {
                                title: root.status;
                                title-color: Theme.secondary;
                            }
                            if root.status != "": Separator { }
                            Row { title: "Path"; value: root.path == "" ? "—" : root.path; dot: root.running && root.path != ""; }
                            Separator { }
                            Row { title: "Last ping"; value: root.last == "" ? "—" : root.last; }
                            Separator { }
                            Row { title: "Time"; value: Math.round(root.elapsed) + " s of " + Math.round(root.secs) + " s"; }
                            Rectangle {
                                height: 3px;
                                Rectangle {
                                    x: 0;
                                    width: root.secs > 0 ? parent.width * min(1, root.elapsed / root.secs) : 0;
                                    background: Theme.accent;
                                }
                            }
                        }
                    }
                }

                if root.rows.length > 0: VerticalLayout {
                    spacing: 6px;
                    Rectangle { height: 12px; }
                    SectionHeader { text: "PATHS (MS)"; }
                    HorizontalLayout {
                        padding-left: Theme.margin;
                        padding-right: Theme.margin;
                        Card {
                            HorizontalLayout {
                                padding-left: Theme.margin;
                                padding-right: Theme.margin;
                                padding-top: 10px;
                                padding-bottom: 4px;
                                spacing: 4px;
                                Text { text: "path"; horizontal-stretch: 1; color: Theme.secondary; font-size: Theme.footnote * 1rem; }
                                Cell { text: "pings"; color: Theme.secondary; font-size: Theme.footnote * 1rem; width: 44px; }
                                Cell { text: "median"; color: Theme.secondary; font-size: Theme.footnote * 1rem; }
                                Cell { text: "p90"; color: Theme.secondary; font-size: Theme.footnote * 1rem; }
                                Cell { text: "max"; color: Theme.secondary; font-size: Theme.footnote * 1rem; }
                            }
                            for r in root.rows: HorizontalLayout {
                                padding-left: Theme.margin;
                                padding-right: Theme.margin;
                                padding-top: 6px;
                                padding-bottom: 6px;
                                spacing: 4px;
                                Text { text: r.path; horizontal-stretch: 1; color: Theme.label; font-size: Theme.subheadline * 1rem; font-weight: 600; }
                                Cell { text: r.pings; width: 44px; }
                                Cell { text: r.median; }
                                Cell { text: r.p90; }
                                Cell { text: r.max; }
                            }
                            Rectangle { height: 6px; }
                        }
                    }
                    HorizontalLayout {
                        padding-left: Theme.margin * 2;
                        padding-right: Theme.margin * 2;
                        SectionFooter { text: root.totals; }
                    }
                }

                if root.log != "": VerticalLayout {
                    spacing: 6px;
                    Rectangle { height: 12px; }
                    SectionHeader { text: "LOG"; }
                    HorizontalLayout {
                        padding-left: Theme.margin;
                        padding-right: Theme.margin;
                        Card {
                            HorizontalLayout {
                                padding: 12px;
                                // A TextInput, not Texts: its preferred height
                                // counts the wrapped lines, and it can be
                                // selected and copied.
                                Rectangle {
                                    height: log.preferred-height;
                                    log := TextInput {
                                        text: root.log;
                                        read-only: true;
                                        single-line: false;
                                        wrap: word-wrap;
                                        color: Theme.label;
                                        font-family: "Menlo";
                                        font-size: Theme.caption * 1rem;
                                        selection-background-color: Theme.accent.with-alpha(0.35);
                                    }
                                }
                            }
                        }
                    }
                }

                // Once, before the first run: the relay must know this id.
                Rectangle { height: 12px; }
                SectionHeader { text: "THIS PHONE"; }
                HorizontalLayout {
                    padding-left: Theme.margin;
                    padding-right: Theme.margin;
                    Card {
                        VerticalLayout {
                            padding-left: Theme.margin;
                            padding-right: Theme.margin;
                            padding-top: 10px;
                            padding-bottom: 10px;
                            spacing: 2px;
                            Text {
                                text: "Probe id";
                                color: Theme.label;
                                font-size: Theme.body * 1rem;
                            }
                            Text {
                                text: root.id == "" ? "…" : root.id;
                                color: Theme.secondary;
                                font-family: "Menlo";
                                font-size: Theme.footnote * 1rem;
                                wrap: char-wrap;
                            }
                        }
                        Separator { }
                        Row {
                            title: "Copy id";
                            title-color: Theme.accent;
                            enabled: root.id != "";
                            clicked => { root.copy-id(); }
                        }
                    }
                }
                HorizontalLayout {
                    padding-left: Theme.margin * 2;
                    padding-right: Theme.margin * 2;
                    SectionFooter {
                        text: "The relay serves only the ids on its allow list. Add this one, once, and deploy the relay again.";
                    }
                }
            }
        }
    }
}

// The model sheet, risen from the bottom over a dimmed screen.
component ModelSheet inherits Rectangle {
    in property <[ModelRow]> models;
    in property <string> chosen;
    in property <length> bottom-inset;
    callback choose(string);
    callback close();

    background: #00000066;
    TouchArea { clicked => { root.close(); } }
    sheet := Rectangle {
        y: parent.height - self.height;
        height: min(parent.height * 0.7, body.preferred-height);
        background: Theme.background;
        border-top-left-radius: 14px;
        border-top-right-radius: 14px;
        clip: true;
        TouchArea { }
        body := VerticalLayout {
            padding-bottom: root.bottom-inset + 12px;
            HorizontalLayout {
                alignment: center;
                padding-top: 6px;
                Rectangle {
                    width: 36px;
                    height: 5px;
                    border-radius: 2.5px;
                    background: Theme.tertiary;
                }
            }
            HorizontalLayout {
                padding-left: Theme.margin;
                padding-right: 8px;
                padding-top: 8px;
                padding-bottom: 8px;
                Text {
                    text: "Chat models";
                    color: Theme.label;
                    font-size: Theme.title3 * 1rem;
                    font-weight: 700;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                TextButton {
                    text: "Done";
                    bold: true;
                    clicked => { root.close(); }
                }
            }
            Scroller {
                preferred-height: options.preferred-height;
                min-height: min(options.preferred-height, 420px);
                options := VerticalLayout {
                    padding-left: Theme.margin;
                    padding-right: Theme.margin;
                    Card {
                        for m[i] in root.models: VerticalLayout {
                            if m.kind == "chat": Row {
                                title: m.name;
                                detail: m.resident ? m.owner + " · in memory" : m.owner;
                                checked: m.id == root.chosen;
                                clicked => { root.choose(m.id); }
                            }
                            if m.kind == "chat" && !m.last: Separator { }
                        }
                    }
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "Kvad";
    // An iPhone's size in points, for running on the Mac while designing.
    preferred-width: 393px;
    preferred-height: 852px;
    background: Theme.background;

    in-out property <bool> connected;
    in-out property <bool> connecting;
    in-out property <string> server-url: "127.0.0.1:5823";
    in-out property <string> api-key;
    in-out property <string> connect-error;
    in-out property <string> connect-notice;
    in-out property <string> server-version;
    in-out property <string> server-who;
    in-out property <int> tab: 0;

    in-out property <[Bubble]> bubbles;
    in-out property <string> model;
    // What the chat's title shows: the model's name without its owner.
    in-out property <string> model-name;
    in-out property <bool> replying;
    in-out property <string> chat-error;
    in-out property <string> draft;
    in-out property <bool> picking-model;

    in-out property <[ModelRow]> models;
    in-out property <bool> models-loading;

    in-out property <bool> probe-open;
    in-out property <string> probe-id;
    in-out property <string> probe-ticket;
    // Which of the lengths a run is: 30 s, 1 min, 5 min.
    in-out property <int> probe-length: 1;
    in-out property <bool> probe-running;
    in-out property <string> probe-status;
    in-out property <string> probe-error;
    in-out property <string> probe-path;
    in-out property <string> probe-last;
    in-out property <float> probe-elapsed;
    in-out property <float> probe-secs;
    in-out property <[ProbeRow]> probe-rows;
    in-out property <string> probe-totals;
    in-out property <string> probe-log;

    callback connect(string, string);
    callback disconnect();
    callback paste-link();
    callback unpair();
    in-out property <string> server-path;
    // The server as More shows it: a kvad:// id cut to its first digits.
    in-out property <string> server-name;
    in-out property <bool> paired;
    callback send(string);
    callback stop();
    callback new-chat();
    callback refresh-models();
    callback choose-model(string);
    callback open-probe();
    callback probe-paste();
    callback probe-copy-id();
    callback probe-start();
    callback probe-stop();

    property <length> top: self.safe-area-insets.top;
    property <length> bottom: self.safe-area-insets.bottom;
    // When the keyboard is up, it covers the tab bar and the content ends at
    // its top edge. How much of the window it covers, not its size: Slint
    // follows the keyboard's frame as it slides, and a keyboard that has slid
    // away keeps its size below the window, which kept the tab bar hidden
    // with nothing to bring it back. And none at all with no field focused:
    // see Typing.
    property <length> keyboard: Typing.active && self.virtual-keyboard-size.height > 0
        ? max(0px, self.height - self.virtual-keyboard-position.y) : 0px;

    if !root.connected: ConnectScreen {
        top-inset: root.top;
        bottom-inset: root.keyboard;
        url <=> root.server-url;
        key <=> root.api-key;
        busy: root.connecting;
        error: root.connect-error;
        notice: root.connect-notice;
        connect(u, k) => { root.connect-notice = ""; root.connect(u, k); }
        open-probe => { root.open-probe(); }
        paste-link => { root.paste-link(); }
    }

    if root.connected: VerticalLayout {
        padding-top: root.top;
        padding-bottom: root.keyboard > 0 ? root.keyboard : 0;
        Rectangle {
            vertical-stretch: 1;
            if root.tab == 0: ChatScreen {
                bubbles: root.bubbles;
                model: root.model;
                model-name: root.model-name;
                replying: root.replying;
                error: root.chat-error;
                draft <=> root.draft;
                send(t) => { root.send(t); }
                stop => { root.stop(); }
                new-chat => { root.new-chat(); }
                pick-model => {
                    root.picking-model = true;
                    root.refresh-models();
                }
            }
            if root.tab == 1: EmptyState {
                icon: @image-url("icons/wave.svg");
                title: "Speak";
                text: "Talk, and watch the words appear as your Mac hears them.";
                badge: "Coming soon";
            }
            if root.tab == 2: EmptyState {
                icon: @image-url("icons/spark.svg");
                title: "Create";
                text: "Images and video, made on your Mac and kept on it.";
                badge: "Coming soon";
            }
            if root.tab == 3: ModelsScreen {
                models: root.models;
                server-line: root.server-version;
                loading: root.models-loading;
                refresh => { root.refresh-models(); }
            }
            if root.tab == 4: MoreScreen {
                server: root.server-name;
                version: root.server-version;
                who: root.server-who;
                path: root.server-path;
                paired: root.paired;
                disconnect => { root.disconnect(); }
                open-probe => { root.open-probe(); }
                unpair => { root.unpair(); }
            }
        }
        if root.keyboard == 0: Rectangle {
            background: Theme.bar;
            height: 49px + root.bottom;
            Rectangle {
                y: 0;
                height: 1phx;
                background: Theme.separator;
            }
            HorizontalLayout {
                padding-bottom: root.bottom;
                TabItem {
                    icon: @image-url("icons/chat.svg");
                    label: "Chat";
                    selected: root.tab == 0;
                    clicked => { root.tab = 0; }
                }
                TabItem {
                    icon: @image-url("icons/wave.svg");
                    label: "Speak";
                    selected: root.tab == 1;
                    clicked => { root.tab = 1; }
                }
                TabItem {
                    icon: @image-url("icons/spark.svg");
                    label: "Create";
                    selected: root.tab == 2;
                    clicked => { root.tab = 2; }
                }
                TabItem {
                    icon: @image-url("icons/stack.svg");
                    label: "Models";
                    selected: root.tab == 3;
                    clicked => {
                        root.tab = 3;
                        root.refresh-models();
                    }
                }
                TabItem {
                    icon: @image-url("icons/more.svg");
                    label: "More";
                    selected: root.tab == 4;
                    clicked => { root.tab = 4; }
                }
            }
        }
    }

    if root.picking-model: ModelSheet {
        models: root.models;
        chosen: root.model;
        bottom-inset: root.bottom;
        choose(id) => {
            root.choose-model(id);
            root.picking-model = false;
        }
        close => { root.picking-model = false; }
    }

    if root.probe-open: NetworkTestScreen {
        top-inset: root.top;
        bottom-inset: root.keyboard > 0 ? root.keyboard : root.bottom;
        id: root.probe-id;
        ticket <=> root.probe-ticket;
        length <=> root.probe-length;
        running: root.probe-running;
        status: root.probe-status;
        error: root.probe-error;
        path: root.probe-path;
        last: root.probe-last;
        elapsed: root.probe-elapsed;
        secs: root.probe-secs;
        rows: root.probe-rows;
        totals: root.probe-totals;
        log: root.probe-log;
        paste => { root.probe-paste(); }
        copy-id => { root.probe-copy-id(); }
        start-test => { root.probe-start(); }
        stop => { root.probe-stop(); }
        close => { root.probe-open = false; }
    }
}
