// The pieces every screen is made of, drawn the way iOS draws its own:
// grouped cards with hairline separators, 44-point touch targets, a pressed
// state on everything that can be pressed.

import { Theme } from "theme.slint";
import { Spinner } from "std-widgets.slint";

// Whether a text field holds the keyboard. Every field sets it as it gains
// and loses focus. A keyboard let go of while it is still sliding in sends
// iOS no word of leaving, and Slint goes on reporting it at full height; with
// no field focused there is no keyboard, whatever Slint was last told.
export global Typing {
    in-out property <bool> active;
}

// Anything that can be pressed: it dims while held, as UIKit's controls do.
export component Pressable inherits Rectangle {
    callback clicked;
    in property <bool> enabled: true;
    out property <bool> pressed: touch.pressed;
    opacity: !root.enabled ? 0.4 : touch.pressed ? 0.55 : 1.0;
    animate opacity { duration: 140ms; easing: ease-out; }
    @children
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

export component Icon inherits Image {
    in property <color> tint: Theme.label;
    colorize: root.tint;
    image-fit: contain;
    width: 24px;
    height: 24px;
}

// The filled button at the bottom of a form.
export component PrimaryButton inherits Pressable {
    in property <string> text;
    in property <bool> busy;
    // The label's colour, for a button on another background than the accent.
    in property <color> ink: Theme.on-accent;
    height: 50px;
    border-radius: 14px;
    background: Theme.accent;
    HorizontalLayout {
        alignment: center;
        spacing: 10px;
        if root.busy: Spinner {
            indeterminate: true;
            width: 18px;
            height: 18px;
            y: (parent.height - self.height) / 2;
        }
        Text {
            text: root.text;
            color: root.ink;
            font-size: Theme.body * 1rem;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}

// A text button in the accent, as in a navigation bar.
export component TextButton inherits Pressable {
    in property <string> text;
    in property <color> tint: Theme.accent;
    in property <bool> bold;
    min-width: Theme.touch;
    height: Theme.touch;
    Text {
        text: root.text;
        color: root.tint;
        font-size: Theme.body * 1rem;
        font-weight: root.bold ? 600 : 400;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
}

// A round icon button, as the composer's send.
export component RoundButton inherits Pressable {
    in property <image> icon;
    in property <color> tint: Theme.on-accent;
    width: 34px;
    height: 34px;
    border-radius: self.width / 2;
    background: Theme.accent;
    Icon {
        source: root.icon;
        tint: root.tint;
        width: 18px;
        height: 18px;
    }
}

// The rule between two rows of a card, inset from the leading edge.
export component Separator inherits Rectangle {
    in property <length> inset: Theme.margin;
    height: 1phx;
    Rectangle {
        x: root.inset;
        width: parent.width - root.inset;
        height: 1phx;
        background: Theme.separator;
    }
}

// An inset grouped section: rounded, on the grouped background.
export component Card inherits Rectangle {
    background: Theme.surface;
    border-radius: Theme.card-corner;
    clip: true;
    VerticalLayout {
        @children
    }
}

// The small caps over a card, over the card's text, which starts a margin
// in from the card.
export component SectionHeader inherits HorizontalLayout {
    in property <string> text;
    padding-left: Theme.margin * 2;
    padding-right: Theme.margin * 2;
    Text {
        text: root.text;
        color: Theme.secondary;
        font-size: Theme.footnote * 1rem;
    }
}

// The grey note under a card.
export component SectionFooter inherits Text {
    color: Theme.secondary;
    font-size: Theme.footnote * 1rem;
    wrap: word-wrap;
}

// A row in a card: a title, a value or detail on the right, an optional
// chevron, and the pressed highlight a table row has.
export component Row inherits Rectangle {
    callback clicked;
    in property <string> title;
    in property <string> detail;
    in property <string> value;
    in property <color> title-color: Theme.label;
    in property <bool> chevron;
    in property <bool> checked;
    in property <bool> enabled: true;
    in property <bool> dot;
    min-height: Theme.touch;
    background: touch.pressed ? Theme.fill : transparent;
    animate background { duration: 120ms; }
    HorizontalLayout {
        padding-left: Theme.margin;
        padding-right: Theme.margin;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 10px;
        if root.dot: Rectangle {
            width: 8px;
            height: 8px;
            y: (parent.height - self.height) / 2;
            border-radius: 4px;
            background: Theme.success;
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                text: root.title;
                color: root.title-color;
                font-size: Theme.body * 1rem;
                overflow: elide;
            }
            if root.detail != "": Text {
                text: root.detail;
                color: Theme.secondary;
                font-size: Theme.subheadline * 1rem;
                overflow: elide;
            }
        }
        // Cut short with an ellipsis, so that a long value gives way rather
        // than push the card past the edge of the screen.
        if root.value != "": Text {
            text: root.value;
            color: Theme.secondary;
            font-size: Theme.body * 1rem;
            vertical-alignment: center;
            horizontal-alignment: right;
            overflow: elide;
        }
        if root.checked: Icon {
            source: @image-url("icons/check.svg");
            tint: Theme.accent;
            width: 20px;
            height: 20px;
            y: (parent.height - self.height) / 2;
        }
        if root.chevron: Icon {
            source: @image-url("icons/chevron-right.svg");
            tint: Theme.tertiary;
            width: 14px;
            height: 14px;
            y: (parent.height - self.height) / 2;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// A labelled field in a card, as a Settings form has them.
export component Field inherits Rectangle {
    callback accepted;
    in property <string> label;
    in property <string> placeholder;
    in property <InputType> input-type: InputType.text;
    in-out property <string> text <=> input.text;
    in property <bool> enabled: true;
    height: Theme.touch;
    // Lets the keyboard go, for a tap or a drag outside the field.
    public function blur() { input.clear-focus(); }
    HorizontalLayout {
        padding-left: Theme.margin;
        padding-right: Theme.margin;
        spacing: 12px;
        Text {
            text: root.label;
            width: 4.8 * 1rem;
            color: Theme.label;
            font-size: Theme.body * 1rem;
            vertical-alignment: center;
        }
        Rectangle {
            horizontal-stretch: 1;
            input := TextInput {
                color: Theme.label;
                font-size: Theme.body * 1rem;
                vertical-alignment: center;
                single-line: true;
                input-type: root.input-type;
                enabled: root.enabled;
                changed has-focus => { Typing.active = self.has-focus; }
                selection-background-color: Theme.accent.with-alpha(0.35);
                accepted => { root.accepted(); }
            }
            if input.text == "": Text {
                x: 0;
                width: parent.width;
                height: parent.height;
                text: root.placeholder;
                color: Theme.tertiary;
                font-size: Theme.body * 1rem;
                vertical-alignment: center;
                horizontal-alignment: left;
                overflow: elide;
            }
        }
    }
}

// The large title at the top of a screen, with an optional action beside it.
export component LargeTitle inherits VerticalLayout {
    in property <string> title;
    in property <string> subtitle;
    padding-left: Theme.margin;
    padding-right: Theme.margin;
    padding-top: 6px;
    padding-bottom: 10px;
    spacing: 2px;
    HorizontalLayout {
        Text {
            text: root.title;
            color: Theme.label;
            font-size: Theme.large-title * 1rem;
            font-weight: 700;
            horizontal-stretch: 1;
        }
        @children
    }
    if root.subtitle != "": Text {
        text: root.subtitle;
        color: Theme.secondary;
        font-size: Theme.subheadline * 1rem;
        overflow: elide;
    }
}

// A screen with nothing in it yet, said kindly.
export component EmptyState inherits VerticalLayout {
    in property <image> icon;
    in property <string> title;
    in property <string> text;
    in property <string> badge;
    alignment: center;
    spacing: 12px;
    padding: 32px;
    HorizontalLayout {
        alignment: center;
        Rectangle {
            width: 76px;
            height: 76px;
            border-radius: 22px;
            background: Theme.accent.with-alpha(0.14);
            Icon {
                source: root.icon;
                tint: Theme.accent;
                width: 36px;
                height: 36px;
            }
        }
    }
    Text {
        text: root.title;
        color: Theme.label;
        font-size: Theme.title2 * 1rem;
        font-weight: 700;
        horizontal-alignment: center;
    }
    Text {
        text: root.text;
        color: Theme.secondary;
        font-size: Theme.body * 1rem;
        horizontal-alignment: center;
        wrap: word-wrap;
    }
    if root.badge != "": HorizontalLayout {
        alignment: center;
        Rectangle {
            border-radius: self.height / 2;
            background: Theme.fill;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 5px;
                padding-bottom: 5px;
                Text {
                    text: root.badge;
                    color: Theme.secondary;
                    font-size: Theme.footnote * 1rem;
                    font-weight: 600;
                }
            }
        }
    }
}

// One tab of the bar.
export component TabItem inherits Rectangle {
    callback clicked;
    in property <image> icon;
    in property <string> label;
    in property <bool> selected;
    horizontal-stretch: 1;
    height: 49px;
    VerticalLayout {
        alignment: center;
        spacing: 3px;
        HorizontalLayout {
            alignment: center;
            Icon {
                source: root.icon;
                tint: root.selected ? Theme.accent : Theme.secondary;
                width: 26px;
                height: 26px;
            }
        }
        Text {
            text: root.label;
            color: root.selected ? Theme.accent : Theme.secondary;
            font-size: Theme.tab-label * 1rem;
            font-weight: 500;
            horizontal-alignment: center;
        }
    }
    TouchArea {
        clicked => { root.clicked(); }
    }
}

// A scrolling view that moves the way UIScrollView does, which Flickable does
// not: the content keeps going when let go and slows down, and past either
// end it stretches under the finger and springs back. It bounces even when
// everything fits, as iOS lists do.
//
// The SwipeGestureHandler holds a press back for 100 ms, as UIKit does, and
// takes it from the content only once it moves 8 points up or down: a tap
// still reaches the button under it.
export component Scroller inherits Rectangle {
    // How far the content is moved, as Flickable's content-y: 0 at the top,
    // negative further down, and past 0 or end-offset while it stretches.
    in-out property <length> offset;
    // Stay with the end as the content grows, while the reader is there: a
    // chat's newest words.
    in property <bool> keep-end;
    in-out property <bool> at-end: true;
    out property <length> content-height: content.preferred-height;
    out property <length> end-offset: min(0px, root.height - root.content-height);
    out property <bool> moving: gesture.swiping || root.coasting;
    // A drag starts: the keyboard goes, as with keyboardDismissMode onDrag.
    callback began();
    // A tap that nothing in the content took.
    callback tapped();

    // In points a second, positive while the content moves down.
    property <float> velocity;
    property <bool> coasting;
    // Where a drag began, the finger's and the content's unstretched one.
    property <length> base;
    property <length> start;
    property <length> last-y;
    property <float> last-ms;

    clip: true;

    changed end-offset => {
        if !root.moving {
            if root.keep-end && root.at-end {
                root.offset = root.end-offset;
            } else if root.offset < root.end-offset {
                root.offset = root.end-offset;
            }
        }
    }

    // UIKit's rubber band: the further past the end, the less it gives.
    pure function rubber(x: length) -> length {
        return (1 - 1 / (x / root.height * 0.55 + 1)) * root.height;
    }
    pure function unrubber(y: length) -> length {
        return root.height / 0.55 * (y / max(1px, root.height - y));
    }
    pure function stretch(raw: length) -> length {
        if raw > 0px {
            return root.rubber(raw);
        }
        if raw < root.end-offset {
            return root.end-offset - root.rubber(root.end-offset - raw);
        }
        return raw;
    }
    pure function unstretch(shown: length) -> length {
        if shown > 0px {
            return root.unrubber(shown);
        }
        if shown < root.end-offset {
            return root.end-offset - root.unrubber(root.end-offset - shown);
        }
        return shown;
    }

    function rest() {
        root.coasting = false;
        root.velocity = 0;
        root.at-end = root.offset <= root.end-offset + 24px;
    }

    function release(v: float) {
        root.velocity = v;
        root.last-ms = animation-tick() / 1ms;
        root.coasting = true;
    }

    // One frame of the coast: inside, slow down at UIKit's normal rate of
    // 0.998 a millisecond; past an end, a critically damped spring of 0.4 s
    // pulls it back.
    function step() {
        let now = animation-tick() / 1ms;
        let dt = max(0.001, min(0.05, (now - root.last-ms) / 1000));
        root.last-ms = now;
        let edge = root.offset > 0px ? 0px : root.end-offset;
        if root.offset > 0px || root.offset < root.end-offset {
            let x = (root.offset - edge) / 1px;
            root.velocity += (-246.7 * x - 31.4 * root.velocity) * dt;
            root.offset += root.velocity * dt * 1px;
            let now-x = (root.offset - edge) / 1px;
            if now-x * x <= 0 || (abs(now-x) < 0.5 && abs(root.velocity) < 10) {
                root.offset = edge;
                root.rest();
            }
        } else {
            root.velocity *= pow(0.998, dt * 1000);
            root.offset += root.velocity * dt * 1px;
            if abs(root.velocity) < 8 {
                root.rest();
            }
        }
    }

    Timer {
        interval: 16ms;
        running: root.coasting;
        triggered => { root.step(); }
    }

    gesture := SwipeGestureHandler {
        handle-swipe-up: true;
        handle-swipe-down: true;
        // A finger down stops a coast where it is, as on iOS; past an end it
        // springs back regardless.
        changed pressed-position => {
            if root.coasting && root.offset <= 0px && root.offset >= root.end-offset {
                root.rest();
            }
        }
        moved => {
            if !self.swiping {
                return;
            }
            let y = self.current-position.y;
            let now = animation-tick() / 1ms;
            if root.base == -1px {
                root.coasting = false;
                root.base = y;
                root.start = root.unstretch(root.offset);
                root.velocity = 0;
                root.last-y = y;
                root.last-ms = now;
                root.began();
            }
            let dt = now - root.last-ms;
            if dt > 0 {
                let v = (y - root.last-y) / 1px / dt * 1000;
                root.velocity = 0.75 * v + 0.25 * root.velocity;
                root.last-y = y;
                root.last-ms = now;
            }
            root.offset = root.stretch(root.start + (y - root.base));
        }
        // A finger that stopped before it lifted throws nothing.
        swiped => {
            root.base = -1px;
            root.release(animation-tick() / 1ms - root.last-ms > 80 ? 0 : root.velocity);
        }
        cancelled => {
            root.base = -1px;
            root.release(0);
        }
        TouchArea {
            clicked => { root.tapped(); }
        }
        content := VerticalLayout {
            width: root.width;
            y: root.offset;
            height: self.preferred-height;
            alignment: LayoutAlignment.start;
            @children
        }
    }

    init => { root.base = -1px; }
}
