/target
# Cargo target directories for other platforms: `cargo zigbuild` is run with
# one of its own (docs/releasing.md), and one run from the wrong directory
# lands wherever that is.
target-*/
/data/*
!/data/.gitkeep
/out/
/web/node_modules/
# Built by `npm run build` and embedded by kvad-serve; the directory itself has
# to exist for rust-embed to compile, which is what the .gitkeep is for.
/web/dist/*
!/web/dist/.gitkeep
*.env

# Python bytecode, from running the fixture scripts.
__pycache__/
